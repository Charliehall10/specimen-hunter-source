{
  "name": "fish-on-desktop",
  "productName": "Fish On!",
  "version": "1.0.0",
  "description": "Fish On! demo slot in its own window",
  "author": "Charlie Hall",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "game": "npm --prefix ../client run build && rm -rf game && cp -r ../client/dist game",
    "start": "npm run game && electron .",
    "dist": "npm run game && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "uk.slotstudio.fishon",
    "productName": "Fish On!",
    "files": [
      "main.cjs",
      "icon.png",
      "game/**"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Game",
      "artifactName": "FishOn.AppImage",
      "syncDesktopName": true,
      "executableName": "fish-on"
    },
    "directories": {
      "output": "release"
    }
  },
  "desktopName": "fish-on.desktop"
}
